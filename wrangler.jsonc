{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startupsearch",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "account_id": "5eebfd13d242a1dc8727f5677b714146",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "e6c6faf989fb4dc5a712984858f8e4ed"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "startupsearch",
      "database_id": "d4ba93ed-695e-40e5-b81c-adc55938d979",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }

  // Custom domains startupsearch.co.uk + www are already attached to
  // this worker at the account level (see Workers dashboard → Settings
  // → Domains & Routes). They persist independently of wrangler.jsonc
  // and don't need to be re-declared here — keeping them out lets the
  // CI deploy skip the zone-level workers/routes reconciliation step
  // (which requires a permission this token doesn't have).
}
