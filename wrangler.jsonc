{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startupsearch",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "account_id": "5eebfd13d242a1dc8727f5677b714146",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "e6c6faf989fb4dc5a712984858f8e4ed"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "startupsearch",
      "database_id": "d4ba93ed-695e-40e5-b81c-adc55938d979",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
